[Unit]
Description=DonutMonitorControl daemon (automatic monitor brightness)
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/donut-monitord
Restart=always
RestartSec=30
Environment=DISPLAY=:0

StandardOutput=journal
StandardError=journal
SyslogIdentifier=donut-monitord

[Install]
WantedBy=default.target
